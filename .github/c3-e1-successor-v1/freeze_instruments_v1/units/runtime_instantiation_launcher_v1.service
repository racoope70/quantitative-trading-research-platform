[Unit]
Description=C3 E1 runtime instantiation launcher

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/c3-e1/freeze-instruments-v1/bin/python_instrument_launcher_v1 C3_E1_SUCCESSOR_RUNTIME_INSTANTIATION_LAUNCHER_V1
Restart=no
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
