[Unit]
Description=C3 E1 runtime instantiation launcher / QEMU process
Requires=host_evidence_sink_v1.service host_runtime_lifecycle_provider_v1.service
After=host_evidence_sink_v1.service host_runtime_lifecycle_provider_v1.service
Before=attestation_transaction_controller_v1.service

[Service]
Type=simple
User=0
Group=0
ExecStart=/opt/c3-e1/freeze-instruments-v1/bin/python_instrument_launcher_v1 C3_E1_SUCCESSOR_RUNTIME_INSTANTIATION_LAUNCHER_V1
Restart=no
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID
RestrictAddressFamilies=AF_UNIX
StandardInput=null
StandardOutput=null
StandardError=null
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
