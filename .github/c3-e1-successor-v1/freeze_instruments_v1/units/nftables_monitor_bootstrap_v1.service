[Unit]
Description=C3 E1 one-shot nftables monitor socket bootstrap
Requires=nftables_transition_monitor_v1.service
After=nftables_transition_monitor_v1.service
Before=observation_authority_v1.service

[Service]
Type=oneshot
User=0
Group=0
ExecStart=/opt/c3-e1/freeze-instruments-v1/bin/python_instrument_launcher_v1 C3_E1_SUCCESSOR_NFTABLES_MONITOR_BOOTSTRAP_V1
RemainAfterExit=no
Restart=no
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
