[Unit]
Description=C3 E1 one-shot nftables monitor bootstrap

[Service]
Type=oneshot
User=61000
Group=61000
ExecStart=/opt/c3-e1/freeze-instruments-v1/bin/python_instrument_launcher_v1 C3_E1_SUCCESSOR_NFTABLES_MONITOR_BOOTSTRAP_V1
Restart=no
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
