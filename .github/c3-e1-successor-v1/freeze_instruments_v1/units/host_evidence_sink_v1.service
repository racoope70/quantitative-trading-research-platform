[Unit]
Description=C3 E1 host evidence sink
After=local-fs.target
Before=host_runtime_lifecycle_provider_v1.service runtime_instantiation_launcher_v1.service attestation_transaction_controller_v1.service

[Service]
Type=simple
User=61010
Group=61010
ExecStart=/opt/c3-e1/freeze-instruments-v1/bin/python_instrument_launcher_v1 C3_E1_SUCCESSOR_HOST_EVIDENCE_SINK_V1
Restart=no
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
