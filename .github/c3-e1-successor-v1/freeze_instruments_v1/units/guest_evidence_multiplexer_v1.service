[Unit]
Description=C3 E1 guest evidence multiplexer

[Service]
Type=simple
User=61001
Group=61001
ExecStart=/opt/c3-e1/freeze-instruments-v1/bin/python_instrument_launcher_v1 C3_E1_SUCCESSOR_GUEST_EVIDENCE_MULTIPLEXER_V1
Restart=no
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
