[Unit]
Description=C3 E1 guest evidence multiplexer
After=local-fs.target
Before=nftables_transition_monitor_v1.service observation_authority_v1.service

[Service]
Type=simple
User=61001
Group=61001
ExecStart=/opt/c3-e1/freeze-instruments-v1/bin/python_instrument_launcher_v1 C3_E1_SUCCESSOR_GUEST_EVIDENCE_MULTIPLEXER_V1
Restart=no
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
