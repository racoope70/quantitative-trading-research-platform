[Unit]
Description=C3 E1 pre/post attestation transaction controller
Requires=host_evidence_sink_v1.service host_runtime_lifecycle_provider_v1.service runtime_instantiation_launcher_v1.service
After=host_evidence_sink_v1.service host_runtime_lifecycle_provider_v1.service runtime_instantiation_launcher_v1.service

[Service]
Type=simple
User=61012
Group=61012
ExecStart=/opt/c3-e1/freeze-instruments-v1/bin/python_instrument_launcher_v1 C3_E1_SUCCESSOR_ATTESTATION_TRANSACTION_CONTROLLER_V1
Restart=no
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
