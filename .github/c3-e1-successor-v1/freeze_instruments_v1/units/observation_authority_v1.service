[Unit]
Description=C3 E1 observation authority
Requires=guest_evidence_multiplexer_v1.service nftables_transition_monitor_v1.service nftables_monitor_bootstrap_v1.service
After=guest_evidence_multiplexer_v1.service nftables_transition_monitor_v1.service nftables_monitor_bootstrap_v1.service

[Service]
Type=simple
User=61000
Group=61000
ExecStart=/opt/c3-e1/freeze-instruments-v1/bin/python_instrument_launcher_v1 C3_E1_SUCCESSOR_OBSERVATION_AUTHORITY_V1
Restart=no
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
