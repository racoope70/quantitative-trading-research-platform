[Unit]
Description=C3 E1 observation authority
Requires=guest_evidence_multiplexer_v1.service nftables_transition_monitor_v1.service nftables_monitor_bootstrap_v1.service
After=guest_evidence_multiplexer_v1.service nftables_transition_monitor_v1.service nftables_monitor_bootstrap_v1.service

[Service]
Type=simple
User=61000
Group=61000
ExecStart=/opt/c3-e1/freeze-instruments-v1/bin/python_instrument_launcher_v1 C3_E1_SUCCESSOR_OBSERVATION_AUTHORITY_V1
Restart=no
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=~mount umount2 pivot_root init_module finit_module delete_module kexec_load kexec_file_load reboot setuid setgid setgroups capset setns unshare ptrace bpf perf_event_open keyctl add_key request_key open_by_handle_at
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
