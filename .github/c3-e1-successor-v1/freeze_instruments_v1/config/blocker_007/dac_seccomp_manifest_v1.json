    "setgid",
    "setgroups",
    "capset",
    "setns",
    "unshare",
    "ptrace",
    "bpf",
    "perf_event_open",
    "keyctl",
    "add_key",
    "request_key",
    "open_by_handle_at"
  ],
  "identity": "C3_E1_SUCCESSOR_OBSERVATION_AUTHORITY_SECURITY_MANIFEST_V1",
  "no_new_privileges": true,
  "positive_allowlist": "UNRESOLVED_IMPLEMENTATION_DERIVED_AFTER_EXACT_RUNTIME_CLOSURE",
